{
  "name": "varlik-takip-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "dist:win": "vite build && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.varliktakip.app",
    "productName": "TK Asset Manager",
    "artifactName": "TK-Asset-Manager.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": ".",
        "filter": [
          "backend/**/*",
          "!backend/.env",
          "!backend/.env.example",
          "!backend/.gitignore",
          "!backend/data/**",
          "!backend/demo-data/**",
          "!backend/scripts/**",
          "!backend/test-smtp-inbox/**",
          "!backend/test-smtp-server.js",
          "!backend/*.cmd",
          "!backend/README.md",
          "!backend/node_modules/smtp-server/**",
          "varlik-takip-app/dist/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "TK-Asset-Manager.exe",
      "splashImage": "build/splash.bmp"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TK Asset Manager",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "TK-Asset-Manager-Kurulum.exe"
    }
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  },
  "description": "TK Asset Manager — varlık takip ve raporlama",
  "author": "TK Asset Manager"
}
